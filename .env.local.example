GEMINI_API_KEY=your_gemini_api_key_here

# --- Cloud sync (Supabase) ---
# Get these from Supabase: Dashboard -> your project -> Settings -> API.
# NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY are required for
# subject/study-plan sync across devices.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional but recommended: the service-role key bypasses Row Level Security.
# Only set it on the SERVER (Vercel env vars), NEVER expose in a browser bundle.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here