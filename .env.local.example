# Required
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Admin password for the /admin login (data/admin-password.json overrides this once set).
ADMIN_PASSWORD=your_admin_password

# --- Cloud sync (Upstash Redis) ---
# Create a free database at https://console.upstash.com/redis, then paste the
# REST API URL and token from its "REST API" tab:
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# --- Optional ---
# YouTube Data API key (must start with "AIza"). If missing/unset, the app
# falls back to public scraping to fetch playlists, so you don't need it.
# YOUTUBE_API_KEY=your_youtube_api_key_here
